# Server Configuration
PORT=5000

# PostgreSQL Database Credentials (for local server/migrate.js)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_admin
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# PostgreSQL Connection URL (for api/index.js or Cloud Deployments like Supabase/Neon/Render)
POSTGRES_URL=postgres://postgres:your_postgres_password@localhost:5432/portfolio_admin
DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/portfolio_admin

# Authentication & Admin Credentials
ADMIN_EMAIL=admin@example.com
# Use a bcrypt hash of your admin password (e.g. generated via bcrypt.hashSync('yourpassword', 10))
ADMIN_PASSWORD_HASH=$2a$10$abcdefghijklmnopqrstuvwxyz0123456789ABCDEF
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Email Service (Nodemailer - Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Cloudinary Image Storage (for production / Vercel image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
